{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BACKEND_URL": "https://REPLACE_WITH_DEPLOYED_BACKEND_URL" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_BACKEND_URL": "https://REPLACE_WITH_DEPLOYED_BACKEND_URL" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium" },
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_BACKEND_URL": "https://REPLACE_WITH_DEPLOYED_BACKEND_URL" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID", "appleTeamId": "REPLACE_WITH_TEAM_ID" },
      "android": { "serviceAccountKeyPath": "./google-play-service-account.json", "track": "internal" }
    }
  }
}
